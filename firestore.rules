rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function logado() {
      return request.auth != null;
    }

    function meuPerfil() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid));
    }

    function ehAdmin() {
      return logado() && meuPerfil().data.tipoLogin in ['google', 'email'];
    }

    match /usuarios/{uid} {
      allow read, write: if logado() && (request.auth.uid == uid || ehAdmin());
    }

    match /servicos/{id} {
      allow read: if logado();
      allow write: if ehAdmin();
    }

    match /agendamentos/{id} {
      allow read, write: if ehAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}