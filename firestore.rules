rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function logado() {
      return request.auth != null;
    }

    // Dono do projeto: pode se promover a admin sozinho.
    function ehDono() {
      return logado()
        && request.auth.token.email == 'dissinho.gangster000@gmail.com';
    }

    function meuPapel() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.papel;
    }

    function ehAdmin() {
      return logado() && (ehDono() || meuPapel() == 'admin');
    }

    // ---- Usuarios ----
    match /usuarios/{uid} {
      allow read:   if ehAdmin() || (logado() && request.auth.uid == uid);
      allow create: if logado() && request.auth.uid == uid;
      allow update: if ehAdmin() || (ehDono() && request.auth.uid == uid);
      allow delete: if ehAdmin();
    }

    // ---- Somente administradores ----
    match /servicos/{id} {
      allow read, write: if ehAdmin();
    }

    match /agendamentos/{id} {
      allow read, write: if ehAdmin();
    }

    match /configuracoes/{id} {
      allow read, write: if ehAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}